{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (raylib)",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1"],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Game",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\uneviedefourmi.exe",
            "dependsOn": "Build (raylib)",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        }
    ]
}
